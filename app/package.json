{
  "name": "kinetic-app",
  "version": "0.1.7",
  "private": true,
  "license": "MIT",
  "description": "Kinetic: universal mouse control for Windows (UI)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run electron:dev\"",
    "electron:build": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outdir=dist-electron",
    "electron:dev": "npm run electron:build && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc --noEmit && vite build && npm run electron:build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:parity": "node tests/accel-parity.ts",
    "shoot": "electron scripts/shoot.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.8.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@44.9.2": true
  },
  "build": {
    "appId": "com.kinetic.mouse",
    "productName": "Kinetic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine/target/release/kinetic-engine.exe",
        "to": "engine/kinetic-engine.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kinetic-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "jamimmehdi",
      "repo": "kinetic"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "kinetic": {
    "repo": {
      "owner": "jamimmehdi",
      "repo": "kinetic"
    },
    "updates": {
      "provider": "github",
      "owner": "jamimmehdi",
      "repo": "kinetic"
    }
  }
}
